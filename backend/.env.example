# Google OAuth credentials (from console.cloud.google.com).
# Register `<MARGIN_PUBLIC_BASE_URL>/api/auth/callback/google` as an
# authorized redirect URI (locally: http://localhost:8787/api/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Drive Picker config (only needed for the extension's "add doc" flow).
#   GOOGLE_API_KEY        — a public "API key" credential from the same GCP
#                           project as the OAuth client. Restrict it to the
#                           Picker API in the Cloud Console.
#   GOOGLE_PROJECT_NUMBER — the numeric GCP project number (NOT the project
#                           ID). Find it on Cloud Console → "Project info".
GOOGLE_API_KEY=
GOOGLE_PROJECT_NUMBER=

# 32-byte master key for envelope encryption of Google refresh tokens at
# rest, base64-encoded. Generate with:
#   deno eval 'console.log(btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32)))))'
MARGIN_MASTER_KEY=

# Better Auth signing/encryption secret. MUST be different from
# MARGIN_MASTER_KEY — that one only protects Google refresh tokens at rest.
# At least 32 chars of random data. Generate with:
#   deno eval 'console.log(btoa(String.fromCharCode(...crypto.getRandomValues(new Uint8Array(32)))))'
BETTER_AUTH_SECRET=

# Postgres connection URLs. DATABASE_URL is the pooled URL used by the app
# (e.g. Neon's `-pooler` host, PgBouncer transaction mode). DATABASE_URL_DIRECT
# is the unpooled URL used only by the migrator — PgBouncer transaction mode
# can't run a session-bound migrator, so DDL needs a real connection.
# For local Postgres or a non-pooled provider, set them to the same value
# (or omit DATABASE_URL_DIRECT — the app falls back to DATABASE_URL).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/margin
# DATABASE_URL_DIRECT=postgresql://postgres:postgres@127.0.0.1:5432/margin

# Port for `deno task serve`. Defaults to 8787.
# PORT=8787

# Any non-empty value enables stack traces on CLI errors.
# DEBUG=1

# Public origin of this backend (no trailing slash). When set, the server
# auto-subscribes a Drive files.watch channel on every new version and runs
# the renew + polling loops in-process. Leave blank in local dev.
# MARGIN_PUBLIC_BASE_URL=https://margin-server.fly.dev

# Whether this instance runs the renew + poll loops. Default on. The loops
# have no cross-process coordination, so when scaling beyond one instance
# set this to 0 on all but one replica to avoid double-renewals and
# concurrent ingest races against the same version.
# MARGIN_RUN_BACKGROUND_LOOPS=0

# Set to 1 when the server runs behind a trusted proxy (Fly edge, nginx, …)
# so the rate limiter trusts `Fly-Client-IP` / `X-Forwarded-For` as the
# client IP. Off → headers are ignored and the socket address is used.
# MARGIN_TRUST_PROXY=1

# Set to 1 to allow `deno task margin e2e seed-project …` to write directly into
# project + version tables, bypassing Drive validation. Used by the
# chrome-devtools-mcp harness against a throwaway local DB. Leave unset
# elsewhere — the CLI refuses to seed without it.
# MARGIN_ALLOW_E2E_SEED=1

# Default --user for the e2e seed CLI. Must match an already-connected user
# (sign in via the extension once with that account first). Only read when
# MARGIN_ALLOW_E2E_SEED=1.
# MARGIN_TEST_USER_EMAIL=

# Email transport for review-request magic links. Default unset → log-only;
# the API and side panel never expose bearer-capability URLs. Set to
# "resend" to send real emails via Resend; requires RESEND_API_KEY and
# MARGIN_EMAIL_FROM. Add other providers behind the same EmailTransport
# interface in src/notify/email.ts.
# MARGIN_EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# MARGIN_EMAIL_FROM=Margin <no-reply@yourdomain.com>

# Slack incoming-webhook URL for notification fan-out. Unset → log-only
# (LogSlackTransport). Phase 5 will replace the webhook approach with a
# full Slack bot using bot-token routing.
# MARGIN_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
